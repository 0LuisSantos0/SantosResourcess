      text-align: center;
    }
    .splash-logo {
      max-height: 100px;
      max-width: 100px;
      object-fit: contain;
      margin-bottom: 20px;
      animation: splashLogoPulse 1s infinite ease-in-out;
    }
    .splash-logo-icon {
      font-size: 5rem;
      color: #6366f1;
      margin-bottom: 20px;
      animation: splashLogoPulse 1s infinite ease-in-out;
    }
    .spinner {
      width: 40px;
      height: 40px;
      border: 4px solid rgba(255,255,255,0.2);
      border-top-color: #22d3ee;
      border-radius: 50%;
      margin: 0 auto;
      animation: spin 1s linear infinite;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    @keyframes splashLogoPulse {
      0% { transform: scale(1); opacity: 1; }
      50% { transform: scale(0.95); opacity: 0.8; }
      100% { transform: scale(1); opacity: 1; }
    }
  </style>
</head>
<body class="d-flex flex-column min-vh-100">
  <div id="splashScreen" class="splash-screen">
    <div class="splash-content">
      <% if (siteSettings.logo_url) { %>
        <img src="<%= siteSettings.logo_url %>" alt="Logo" class="splash-logo">
      <% } else { %>
        <i class="fa-solid fa-cube splash-logo-icon"></i>
      <% } %>
      <div class="spinner"></div>
    </div>
  </div>
  <nav class="navbar navbar-expand-lg navbar-dark navbar-glass fixed-top">
    <div class="container">
      <a class="navbar-brand fw-bold d-flex align-items-center" href="/">
        <% if (siteSettings.logo_url) { %>
          <img src="<%= siteSettings.logo_url %>" alt="Logo" class="me-2" style="height: 30px; width: 30px; object-fit: contain;">
        <% } else { %>
          <i class="fa-solid fa-cube me-2 text-primary" style="color: #6366f1;"></i>
        <% } %>
        Santos Resources
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav mx-auto">
          <li class="nav-item"><a class="nav-link" href="/">Início</a></li>
          <li class="nav-item"><a class="nav-link active" href="/products">Produtos</a></li>
          <li class="nav-item"><a class="nav-link" href="/about">Sobre Nós</a></li>
          <li class="nav-item"><a class="nav-link" href="https://discord.gg/8GyNS5vRgt" target="_blank"><i class="fa-brands fa-discord me-1"></i> Discord</a></li>
        </ul>
        <div class="d-flex align-items-center gap-3">
          <% if (user) { %>
            <div class="dropdown">
              <span class="text-light small dropdown-toggle d-flex align-items-center gap-2" style="cursor: pointer;">
                <% if (user.avatar) { %>
                  <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" width="30" height="30" class="rounded-circle border border-light" alt="Avatar" style="object-fit: cover;">
                <% } else { %>
                  <i class="fa-regular fa-circle-user fa-lg"></i>
                <% } %>
                <strong class="d-none d-md-inline"><%= user.username %></strong>
              </span>
              <ul class="dropdown-menu dropdown-menu-end">
                <% if (isAdmin) { %>
                  <li><a class="dropdown-item" href="/admin/dashboard"><i class="fa-solid fa-screwdriver-wrench text-warning"></i> Painel Admin</a></li>
                  <li><hr class="dropdown-divider"></li>
                <% } %>
                <li><a class="dropdown-item" href="/logout"><i class="fa-solid fa-right-from-bracket text-danger"></i> Sair</a></li>
              </ul>
            </div>
          <% } else { %>
            <a href="/auth/discord" class="btn btn-primary btn-sm px-4 rounded-pill btn-glow"><i class="fa-brands fa-discord me-2"></i>Entrar</a>
          <% } %>
        </div>
      </div>
    </div>
  </nav>

  <main class="flex-fill">
    <div class="page-header section-glow">
      <div class="container">
        <h1 data-aos="fade-down">Todos os Nossos Produtos</h1>
        <p class="lead text-light opacity-75" data-aos="fade-down" data-aos-delay="100">Conheça todas as soluções disponíveis.</p>
      </div>
    </div>

    <div class="container mt-5">
      <% if (locals.error) { %><div class="alert alert-danger"><%= locals.error %></div><% } %>
      
      <div class="row mb-4 align-items-center g-3" data-aos="fade-up">
        <div class="col-md-5"><input type="text" id="searchInput" class="search-input w-100" placeholder="Pesquisar por nome..."></div>
        <div class="col-md-3"><select id="sortPrice" class="filter-select w-100"><option value="default">Preço</option><option value="low-high">Mais Baratos</option><option value="high-low">Mais Caros</option></select></div>
        <div class="col-md-4"><select id="sortCategory" class="filter-select w-100"><option value="default">Categoria</option><option value="MTA">MTA</option><option value="Discord Bot">Discord</option><option value="Site">Site</option></select></div>
      </div>

      <div id="productsGrid" class="row row-cols-1 row-cols-md-3 g-4">
        <% if (products.length === 0) { %>
          <div class="col-12 text-center text-muted py-5"><h4><i class="fa-regular fa-circle-question me-2"></i> Nenhum produto cadastrado!</h4></div>
        <% } else { %>
          <% products.forEach((p, index) => { %>
            <div class="col product-item" data-name="<%= p.name.toLowerCase() %>" data-category="<%= p.category %>" data-price="<%= p.price %>">
              <div class="card product-card-ref">
                <div class="card-body">
                  <% if (p.badge && p.badge.trim() !== '') { %>
                    <div class="product-badge" style="border-color: <%- p.badge_color || '#94a3b8' %>; color: <%- p.badge_color || '#94a3b8' %>;">
                      <%= p.badge %>
                    </div>
                  <% } %>

                  <button class="btn-info" onclick="openInfoModal(<%= p.id %>, '<%= p.name.replace(/'/g, "\\'") %>', '<%= p.video_link || "" %>', `<%= p.features || "" %>`)" title="Ver detalhes"><i class="fa-solid fa-info"></i></button>
                  
                  <div class="product-image-area">
                    <% if (p.thumbnail && p.thumbnail.trim() !== '') { %>
                      <img src="<%= p.thumbnail %>" alt="<%= p.name %>" onerror="this.style.display='none'; this.parentElement.querySelector('.img-placeholder').style.display='flex';">
                    <% } %>
                    <div class="img-placeholder" style="<%= (p.thumbnail && p.thumbnail.trim() !== '') ? 'display: none;' : 'display: flex;' %>">
                      <i class="fa-solid fa-box"></i>
                      <span><%= p.category %></span>
                    </div>
                  </div>

                  <h5 class="product-title"><%= p.name %></h5>
                  <div class="product-price">€<%= p.price.toFixed(2) %></div>
                  <button class="btn-buy" onclick="addToCart(<%= p.id %>, '<%= p.name.replace(/'/g, "\\'") %>', <%= p.price %>, '<%= p.category %>', event)">COMPRAR</button>
                </div>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </main>

  <footer>
    <div class="container">
      <div class="row">
        <div class="col-md-4 mb-4">
          <h5 class="fw-bold d-flex align-items-center">
            <% if (siteSettings.logo_url) { %>
              <img src="<%= siteSettings.logo_url %>" alt="Logo" class="me-2" style="height: 28px; width: 28px; object-fit: contain;">
            <% } else { %>
              <i class="fa-solid fa-cube text-primary me-2"></i>
            <% } %>
            Santos Resources
          </h5>
          <p class="footer-tagline mt-2">Soluções de alta performance para MTA e Discord. Confiança e qualidade.</p>
        </div>
        <div class="col-md-4 mb-4 text-center">
          <h6 class="fw-bold">Links Rápidos</h6>
          <div class="d-flex flex-column">
            <a href="/products" class="small mb-1">Produtos</a>
            <a href="/about" class="small mb-1">Sobre Nós</a>
            <a href="https://discord.gg/8GyNS5vRgt" target="_blank" class="small">Discord</a>
          </div>
        </div>
        <div class="col-md-4 mb-4 text-end">
          <h6 class="fw-bold">Redes Sociais</h6>
          <div class="d-flex justify-content-end gap-2">
            <a href="https://discord.gg/8GyNS5vRgt" target="_blank" class="social-icon"><i class="fa-brands fa-discord"></i></a>
          </div>
        </div>
      </div>
      <hr class="footer-divider">
      <p class="mb-0 small text-center text-light opacity-75">&copy; 2026 Santos Resources. Todos os direitos reservados.</p>
    </div>
  </footer>

  <!-- Botão Carrinho (abre o drawer lateral) -->
  <button class="cart-floating-btn" data-bs-toggle="offcanvas" data-bs-target="#cartDrawer"><i class="fa-solid fa-cart-shopping fa-lg"></i><span class="cart-badge" id="cartCount">0</span></button>

  <button id="backToTop" onclick="window.scrollTo({ top: 0, behavior: 'smooth' });"><i class="fa-solid fa-arrow-up"></i></button>

  <!-- Modal Detalhes -->
  <div class="modal fade modal-dark" id="infoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header p-4">
          <h5 class="modal-title fw-bold text-white"><i class="fa-solid fa-circle-info text-primary me-2"></i> Informações do Produto</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4 pt-0">
          <div class="ratio ratio-16x9" id="modalVideoContainer">
            <iframe id="modalVideoIframe" src="" allowfullscreen frameborder="0"></iframe>
          </div>
          <h3 id="modalProductTitle">Sistema de Empresas</h3>
          <div class="d-flex align-items-start">
            <span class="bg-primary bg-opacity-10 text-white px-3 py-1 rounded-pill mb-3"><i class="fa-solid fa-info-circle me-2"></i> O sistema possui as seguintes funcionalidades:</span>
          </div>
          
          <div class="features-code-block">
            <ul id="modalFeaturesList"><li>Carregando funcionalidades...</li></ul>
          </div>
          <div class="text-center mt-4">
            <button type="button" class="btn btn-dark rounded-pill px-5 fw-bold border border-secondary" data-bs-dismiss="modal">FECHAR</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 🛒 DRAWER CARRINHO (LATERAL) -->
  <div class="offcanvas offcanvas-end cart-offcanvas" tabindex="-1" id="cartDrawer" aria-labelledby="cartDrawerLabel">
    <div class="offcanvas-header">
      <h5 class="offcanvas-title fw-bold" id="cartDrawerLabel"><i class="fa-solid fa-cart-shopping text-info me-2"></i> Seu Carrinho</h5>
      <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    
    <div class="offcanvas-body d-flex flex-column p-0">
      <!-- Área dos Produtos (Scroll) -->
      <div class="cart-items-scroll">
        <div id="cartItemsContainer">
          <div id="emptyCartMsg" class="text-center py-5">
            <i class="fa-solid fa-cart-plus cart-empty-icon"></i>
            <h5 class="text-secondary">Seu carrinho está vazio.</h5>
            <p class="text-muted small">Adicione produtos para continuar.</p>
          </div>
          <ul class="list-group list-group-flush" id="cartItemsList" style="display: none;"></ul>
        </div>
      </div>

      <!-- Rodapé Fixo (Sempre visível) -->
      <div class="cart-footer-sticky">
        <!-- Cupom de Desconto -->
        <div class="coupon-section">
          <div class="d-flex gap-2">
            <input type="text" id="couponInput" class="form-control" placeholder="Cupom de desconto">
            <button id="applyCouponBtn" class="btn btn-outline-info rounded-pill px-3" onclick="applyCoupon()">Aplicar</button>
            <button id="removeCouponBtn" class="btn btn-outline-danger rounded-pill px-3 d-none" onclick="removeCoupon()">Remover</button>
          </div>
          <div id="couponFeedback" class="coupon-feedback text-info"></div>
        </div>
        
        <div class="d-flex justify-content-between small text-light opacity-75">
          <span>Subtotal:</span>
          <span id="cartSubtotal">€0.00</span>
        </div>
        <div class="d-flex justify-content-between small text-success d-none" id="discountRow">
          <span>Desconto (<span id="discountPercent">0</span>%):</span>
          <span id="cartDiscount">-€0.00</span>
        </div>
        <div class="d-flex justify-content-between fw-bold text-white mt-2">
          <span>Total:</span>
          <span class="cart-total-price" id="cartTotal">€0.00</span>
        </div>

        <!-- Botão Pagamento -->
        <div class="mt-3">
          <a href="https://discord.gg/8GyNS5vRgt" target="_blank" class="btn btn-success w-100 rounded-pill fw-bold btn-glow"><i class="fa-brands fa-discord me-2"></i> Processar Pagamento</a>
        </div>
      </div>
    </div>
  </div>

  <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1050">
    <div id="mtaAlertToast" class="toast align-items-center text-white bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true">
      <div class="d-flex">
        <div class="toast-body"><i class="fa-solid fa-circle-exclamation me-2"></i> Apenas um produto MTA pode ser adicionado ao carrinho.</div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  <script>AOS.init({ duration: 800, once: true });</script>

  <script>
    window.addEventListener('scroll', function() {
      const btn = document.getElementById('backToTop');
      if (window.scrollY > 300) { btn.style.display = 'block'; } else { btn.style.display = 'none'; }
    });

    let cart = [];
    let appliedCoupon = null;

    async function loadCart() {
      try {
        const response = await fetch('/api/cart');
        if (response.ok) {
          cart = await response.json();
          updateCartUI();
        }
        const couponResponse = await fetch('/api/coupon/status');
        if (couponResponse.ok) {
          const data = await couponResponse.json();
          if (data.coupon) {
            appliedCoupon = { code: data.coupon.code, percentage: data.coupon.percentage };
            document.getElementById('couponInput').value = data.coupon.code;
            document.getElementById('couponInput').disabled = true;
            document.getElementById('applyCouponBtn').classList.add('d-none');
            document.getElementById('removeCouponBtn').classList.remove('d-none');
            document.getElementById('couponFeedback').textContent = `Cupom ${data.coupon.code} aplicado!`;
            document.getElementById('couponFeedback').classList.remove('text-danger');
            document.getElementById('couponFeedback').classList.add('text-success');
            updateCartUI();
          }
        }
      } catch (e) {
        console.error('Erro ao carregar carrinho:', e);
      }
    }

    async function saveCart() {
      try {
        await fetch('/api/cart', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ cart })
        });
      } catch (e) {
        console.error('Erro ao guardar carrinho:', e);
      }
    }

    document.addEventListener('DOMContentLoaded', loadCart);

    function addToCart(id, name, price, category, event) {
      if (category === 'MTA') {
        const hasMTA = cart.some(item => item.category === 'MTA');
        if (hasMTA) {
          const toastElement = document.getElementById('mtaAlertToast');
          const toast = new bootstrap.Toast(toastElement);
          toast.show();
          return;
        }
      }

      const existing = cart.find(i => i.id === id);
      if (existing) existing.quantity += 1;
      else cart.push({ id, name, price, quantity: 1, category });
      saveCart();
      updateCartUI();
      const btn = event.target.closest('button');
      const orig = btn.innerHTML;
      btn.innerHTML = '<i class="fa-solid fa-check"></i> Adicionado';
      btn.classList.add('btn-success');
      setTimeout(() => { btn.innerHTML = orig; btn.classList.remove('btn-success'); }, 2000);
    }

    function changeQuantity(index, delta) {
        const item = cart[index];
        if (item.category === 'MTA' && delta > 0 && item.quantity >= 1) {
            const toastElement = document.getElementById('mtaAlertToast');
            const toast = new bootstrap.Toast(toastElement);
            toast.show();
            return;
        }

        cart[index].quantity += delta;

        if (cart[index].quantity <= 0) {
            removeFromCart(index);
            return;
        }

        saveCart();
        updateCartUI();
    }

    function updateCartUI() {
      const badge = document.getElementById('cartCount');
      const list = document.getElementById('cartItemsList');
      const empty = document.getElementById('emptyCartMsg');
      const totalSpan = document.getElementById('cartTotal');
      const subtotalSpan = document.getElementById('cartSubtotal');
      const discountSpan = document.getElementById('cartDiscount');
      const discountRow = document.getElementById('discountRow');
      const discountPercentSpan = document.getElementById('discountPercent');
      
      const totalItems = cart.reduce((sum, i) => sum + i.quantity, 0);
      const previousCount = (updateCartUI.prevCount || 0);
      if (totalItems !== previousCount) {
        badge.classList.add('cart-badge-bounce');
        setTimeout(() => badge.classList.remove('cart-badge-bounce'), 500);
      }
      updateCartUI.prevCount = totalItems;
      badge.textContent = totalItems;
      
      if (cart.length === 0) {
        list.style.display = 'none';
        empty.style.display = 'block';
        subtotalSpan.textContent = '€0.00';
        totalSpan.textContent = '€0.00';
        discountRow.classList.add('d-none');
        return;
      }
      
      empty.style.display = 'none';
      list.style.display = 'block';
      
      let subtotal = 0;
      list.innerHTML = cart.map((item, idx) => {
        const itemTotal = item.price * item.quantity;
        subtotal += itemTotal;
        return `<li class="list-group-item d-flex justify-content-between align-items-center px-0 border-0 border-bottom">
          <div>
            <div><span class="fw-semibold">${item.name}</span></div>
            <div class="d-flex align-items-center mt-1">
              <button class="btn btn-sm btn-outline-secondary rounded-circle px-2 me-1" onclick="changeQuantity(${idx}, -1)">-</button>
              <span class="mx-1 fw-bold">${item.quantity}</span>
              <button class="btn btn-sm btn-outline-secondary rounded-circle px-2 ms-1" onclick="changeQuantity(${idx}, 1)">+</button>
            </div>
          </div>
          <div><span class="fw-bold me-3">€${itemTotal.toFixed(2)}</span>
            <button class="btn btn-sm btn-outline-danger rounded-circle" onclick="removeFromCart(${idx})"><i class="fa-solid fa-xmark"></i></button>
          </div>
        </li>`;
      }).join('');
      
      subtotalSpan.textContent = `€${subtotal.toFixed(2)}`;
      
      let discount = 0;
      if (appliedCoupon) {
        discount = subtotal * (appliedCoupon.percentage / 100);
        discountPercentSpan.textContent = appliedCoupon.percentage;
        discountSpan.textContent = `-€${discount.toFixed(2)}`;
        discountRow.classList.remove('d-none');
      } else {
        discountRow.classList.add('d-none');
      }
      
      totalSpan.textContent = `€${(subtotal - discount).toFixed(2)}`;
    }

    function removeFromCart(index) {
      cart.splice(index, 1);
      saveCart();
      updateCartUI();
    }

    async function applyCoupon() {
      const code = document.getElementById('couponInput').value.trim();
      if (!code) return;
      const response = await fetch('/api/coupon/apply', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code })
      });
      const data = await response.json();
      if (data.success) {
        appliedCoupon = data;
        document.getElementById('couponInput').disabled = true;
        document.getElementById('applyCouponBtn').classList.add('d-none');
        document.getElementById('removeCouponBtn').classList.remove('d-none');
        document.getElementById('couponFeedback').textContent = `Cupom ${data.code} aplicado!`;
        document.getElementById('couponFeedback').classList.remove('text-danger');
        document.getElementById('couponFeedback').classList.add('text-success');
        updateCartUI();
      } else {
        document.getElementById('couponFeedback').textContent = data.error || 'Cupom inválido';
        document.getElementById('couponFeedback').classList.remove('text-success');
        document.getElementById('couponFeedback').classList.add('text-danger');
      }
    }

    async function removeCoupon() {
      const response = await fetch('/api/coupon/remove', { method: 'POST' });
      if (response.ok) {
        appliedCoupon = null;
        document.getElementById('couponInput').disabled = false;
        document.getElementById('couponInput').value = '';
        document.getElementById('applyCouponBtn').classList.remove('d-none');
        document.getElementById('removeCouponBtn').classList.add('d-none');
        document.getElementById('couponFeedback').textContent = '';
        updateCartUI();
      }
    }

    function openInfoModal(id, name, videoUrl, featuresText) {
      const modal = new bootstrap.Modal(document.getElementById('infoModal'));
      document.getElementById('modalProductTitle').textContent = name;
      const iframe = document.getElementById('modalVideoIframe');
      const container = document.getElementById('modalVideoContainer');
      if (videoUrl && videoUrl.trim() !== '') {
        container.style.display = 'block';
        iframe.src = videoUrl;
      } else {
        container.style.display = 'none';
        iframe.src = '';
      }
      const list = document.getElementById('modalFeaturesList');
      list.innerHTML = '';
      if (featuresText && featuresText.trim() !== '') {
        const featuresArray = featuresText.split('\n').filter(f => f.trim() !== '');
        featuresArray.forEach(f => {
          const li = document.createElement('li');
          li.textContent = f.trim();
          list.appendChild(li);
        });
      } else {
        list.innerHTML = '<li class="text-secondary">Este produto não possui funcionalidades listadas.</li>';
      }
      modal.show();
    }

    const productItems = document.querySelectorAll('.product-item');
    function filterAndSort() {
      const searchTerm = document.getElementById('searchInput').value.toLowerCase();
      const priceSort = document.getElementById('sortPrice').value;
      const categorySort = document.getElementById('sortCategory').value;
      let visible = Array.from(productItems).filter(item => {
        const name = item.getAttribute('data-name');
        return name.includes(searchTerm);
      });
      if (categorySort !== 'default') {
        visible.sort((a,b) => {
          const catA = a.getAttribute('data-category');
          const catB = b.getAttribute('data-category');
          if (categorySort === 'MTA') return (catA === 'MTA' ? 0 : 1) - (catB === 'MTA' ? 0 : 1);
          if (categorySort === 'Discord Bot') return (catA === 'Discord Bot' ? 0 : 1) - (catB === 'Discord Bot' ? 0 : 1);
          return 0;
        });
      }
      if (priceSort !== 'default') {
        visible.sort((a,b) => {
          const priceA = parseFloat(a.getAttribute('data-price'));
          const priceB = parseFloat(b.getAttribute('data-price'));
          return priceSort === 'low-high' ? priceA - priceB : priceB - priceA;
        });
      }
      const grid = document.getElementById('productsGrid');
      grid.innerHTML = '';
      visible.forEach(item => grid.appendChild(item));
    }
    document.getElementById('searchInput').addEventListener('input', filterAndSort);
    document.getElementById('sortPrice').addEventListener('change', filterAndSort);
    document.getElementById('sortCategory').addEventListener('change', filterAndSort);
    document.addEventListener('DOMContentLoaded', function() {
      const cartBtn = document.querySelector('.cart-floating-btn');
      const cartOffcanvas = document.getElementById('cartDrawer');
      
      if (cartBtn && cartOffcanvas) {
        // Quando o offcanvas está a abrir
        cartOffcanvas.addEventListener('show.bs.offcanvas', function() {
          cartBtn.classList.add('pulse');
          setTimeout(() => cartBtn.classList.remove('pulse'), 500);
        });
      }
    });
    window.addEventListener('load', function() {
      setTimeout(() => {
        const splash = document.getElementById('splashScreen');
        if (splash) splash.classList.add('hidden');
      }, 1000);
    });

    document.getElementById('sortCategory').addEventListener('change', function() {
      const splash = document.getElementById('splashScreen');
      if (splash) {
        splash.classList.remove('hidden');
        setTimeout(() => {
          splash.classList.add('hidden');
        }, 500);
      }
    });
  </script>
</body>
</html>