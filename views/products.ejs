<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Santos Resources | Loja Oficial</title>
  
  <link rel="icon" href="<%= siteSettings.logo_url ? siteSettings.logo_url : 'data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🛒</text></svg>' %>" />
  
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800;900&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
  <style>
    :root {
      --primary: #6366f1;
      --primary-dark: #4f46e5;
      --dark-bg: #0b1120;
      --card-bg: rgba(255,255,255,0.05);
      --glass-border: rgba(255,255,255,0.1);
    }

    * { box-sizing: border-box; }
    body {
      font-family: 'Inter', sans-serif;
      background-color: #f8fafc;
      color: #1e293b;
      overflow-x: hidden;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* NAVBAR */
    .navbar-glass {
      background: rgba(11, 17, 32, 0.8);
      backdrop-filter: blur(16px) saturate(180%);
      border-bottom: 1px solid var(--glass-border);
      transition: all 0.3s ease;
      padding: 0.8rem 0;
    }
    .navbar-glass .nav-link {
      color: rgba(255,255,255,0.7);
      font-weight: 500;
      transition: color 0.2s;
      position: relative;
    }
    .navbar-glass .nav-link:hover,
    .navbar-glass .nav-link.active { color: #fff; }
    .navbar-glass .nav-link::after {
      content: '';
      position: absolute;
      width: 0;
      height: 2px;
      bottom: 0;
      left: 50%;
      background: var(--primary);
      transition: all 0.3s;
      transform: translateX(-50%);
    }
    .navbar-glass .nav-link:hover::after,
    .navbar-glass .nav-link.active::after { width: 80%; }

    .navbar .dropdown-menu {
      background-color: #1e293b;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 12px;
      padding: 0.5rem;
      min-width: 180px;
      margin-top: 0.5rem;
      box-shadow: 0 15px 40px rgba(0,0,0,0.4);
      position: absolute;
      top: 100%;
      right: 0;
      left: auto;
    }
    .navbar .dropdown-item {
      color: #94a3b8;
      border-radius: 8px;
      padding: 10px 15px;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .navbar .dropdown-item:hover, 
    .navbar .dropdown-item:focus {
      background: rgba(255,255,255,0.1);
      color: #ffffff;
      transform: translateX(3px);
    }
    .navbar .dropdown-divider {
      border-color: rgba(255,255,255,0.06);
      margin: 4px 0;
    }
    .dropdown-toggle {
      cursor: pointer;
      user-select: none;
    }
    .dropdown-toggle::after {
      display: none; 
    }
    .navbar .dropdown:hover .dropdown-menu {
      display: block;
      margin-top: 0.25rem;
    }

    /* GLOW */
    .section-glow { position: relative; box-shadow: 0 10px 30px -10px rgba(34, 211, 238, 0.5); }
    .section-glow::after { content: ''; position: absolute; bottom: -1px; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, transparent, #22d3ee, #6366f1, transparent); box-shadow: 0 0 15px rgba(34, 211, 238, 0.8); z-index: 10; }

    .page-header {
      padding: 140px 0 80px;
      background: radial-gradient(circle at 10% 20%, #1e1b4b 0%, #0f172a 70%, #0b1120 100%);
      color: white;
      text-align: center;
    }
    .page-header h1 { font-weight: 900; font-size: clamp(2.5rem, 5vw, 4rem); }

    .product-card-ref {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: 0;
      transition: 0.3s ease;
      position: relative;
      overflow: hidden;
      height: 100%;
      box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }
    .product-card-ref:hover {
      border-color: #000000;
      transform: translateY(-6px);
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }
    .product-card-ref .card-body {
      padding: 20px;
      text-align: center;
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .product-badge {
      position: absolute;
      top: 12px;
      left: 12px;
      background: #0b1120;
      padding: 6px 12px;
      border-radius: 4px;
      font-size: 0.7rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      z-index: 10;
      border: 2px solid #94a3b8;
      color: #94a3b8;
      font-family: 'Inter', sans-serif;
      box-shadow: 0 2px 6px rgba(0,0,0,0.3);
    }

    /* ÁREA DA IMAGEM - FUNDO BRANCO COM BORDA ÍNDIGO (STROKE) */
    .product-image-area {
      width: 100%;
      height: 180px;
      margin-bottom: 15px;
      border-radius: 12px;
      background: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      position: relative;
      padding: 0;
      border: 2px solid #6366f1;
    }
    .product-image-area img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .img-placeholder {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: #475569;
      width: 100%;
      height: 100%;
      position: absolute;
      top: 0;
      left: 0;
    }
    .img-placeholder i {
      font-size: 2.5rem;
      opacity: 0.6;
      margin-bottom: 10px;
      color: #94a3b8;
    }
    .img-placeholder span {
      font-size: 0.9rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
      opacity: 0.9;
      text-align: center;
      color: #475569;
    }

    .product-card-ref .product-title {
      color: #000;
      font-weight: 600;
      font-size: 1.1rem;
      margin-bottom: 10px;
      flex-grow: 1;
    }
    .product-card-ref .product-price {
      color: #22d3ee;
      font-weight: 700;
      font-size: 1.4rem;
      margin-bottom: 15px;
    }
    .product-card-ref .btn-buy {
      background: #22d3ee;
      color: #000;
      border-radius: 8px;
      width: 100%;
      font-weight: 700;
      padding: 12px;
      border: none;
      transition: all 0.3s ease;
    }
    .product-card-ref .btn-buy:hover {
      background: #67e8f9;
      transform: translateY(-3px) scale(1.02);
      box-shadow: 0 8px 25px rgba(34, 211, 238, 0.6);
    }

    .product-card-ref .btn-info {
      position: absolute;
      top: 15px;
      right: 15px;
      background: #f1f5f9;
      color: #000;
      border-radius: 50%;
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid #e2e8f0;
      transition: 0.2s;
      z-index: 10;
      opacity: 0;
      pointer-events: none;
    }
    .product-card-ref:hover .btn-info {
      opacity: 1;
      pointer-events: auto;
    }

    .btn-glow { transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important; }
    .btn-glow:hover { transform: translateY(-3px) scale(1.03); box-shadow: 0 8px 25px rgba(34, 211, 238, 0.5); }

    .search-input { border-radius: 50px; padding: 12px 20px; border: 1px solid #e2e8f0; transition: 0.2s; }
    .search-input:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(99,102,241,0.15); }
    .filter-select { border-radius: 50px; padding: 10px 20px; border: 1px solid #e2e8f0; background: white; }

    .cart-floating-btn { position: fixed; bottom: 30px; right: 30px; z-index: 999; background: #0f172a; color: white; border-radius: 50px; padding: 16px 28px; box-shadow: 0 10px 40px rgba(0,0,0,0.3); border: none; transition: all 0.3s ease; }
    .cart-floating-btn:hover { transform: scale(1.05); background: #1e293b; box-shadow: 0 8px 30px rgba(15, 23, 42, 0.6); }
    .cart-badge { position: absolute; top: -6px; right: -6px; background: #ef4444; color: white; border-radius: 50%; width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: bold; }

    #backToTop { position: fixed; bottom: 100px; right: 30px; z-index: 999; display: none; border-radius: 50px; padding: 12px 16px; border: none; background: var(--primary); color: white; box-shadow: 0 4px 10px rgba(0,0,0,0.2); transition: 0.3s; cursor: pointer; font-size: 1.2rem; }
    #backToTop:hover { background: var(--primary-dark); transform: translateY(-3px); }

    /* FOOTER */
    footer { background: #0b1120; color: #cbd5e1; padding: 50px 0 20px; margin-top: auto; }
    footer h5, footer h6 { color: #ffffff; font-weight: 600; }
    footer a { color: #a5b4fc; text-decoration: none; transition: 0.2s; }
    footer a:hover { color: var(--primary); }
    .footer-divider { border-color: rgba(255,255,255,0.12); }
    .footer-tagline { color: #e2e8f0; font-size: 0.875rem; line-height: 1.6; }

    .social-icon { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,0.08); color: #fff; transition: all 0.3s; }
    .social-icon:hover { background: var(--primary); transform: translateY(-3px); }

    /* MODAL DETALHES */
    .modal-dark { background: rgba(0, 0, 0, 0.8) !important; }
    .modal-dark .modal-content { background: #0f172a; border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 20px; }
    .modal-dark .modal-header { border-bottom: none; }
    .modal-dark .modal-body h3 { color: white; font-weight: 700; margin-top: 15px; }
    .features-code-block { background: #020617; border-radius: 12px; padding: 20px; margin-top: 10px; border: 1px solid #1e293b; font-family: 'Inter', sans-serif; }
    .features-code-block ul { list-style: none; padding-left: 0; margin: 0; }
    .features-code-block li { padding: 6px 0; font-size: 0.95rem; color: #cbd5e1; }
    .features-code-block li::before { content: '⚙️ '; color: #22d3ee; }

    /* 🛒 DRAWER CARRINHO (LATERAL) */
    .cart-offcanvas {
      background-color: #1e293b !important;
      color: #f1f5f9;
      width: 400px !important;
      border-left: 1px solid rgba(255,255,255,0.1);
    }
    .cart-offcanvas .offcanvas-header {
      border-bottom: 1px solid rgba(255,255,255,0.05);
      padding: 1.2rem 1.5rem;
    }
    .cart-offcanvas .offcanvas-header .btn-close {
      filter: invert(1) grayscale(100%) brightness(200%);
    }
    /* Área dos produtos: apenas esta parte dá scroll */
    .cart-items-scroll {
      flex: 1;
      overflow-y: auto;
      padding: 1rem 1.5rem;
    }
    .cart-items-scroll::-webkit-scrollbar { width: 6px; }
    .cart-items-scroll::-webkit-scrollbar-track { background: #1e293b; }
    .cart-items-scroll::-webkit-scrollbar-thumb { background: #475569; border-radius: 10px; }
    .cart-items-scroll::-webkit-scrollbar-thumb:hover { background: #64748b; }
    
    /* Rodapé fixo do carrinho (sempre visível) */
    .cart-footer-sticky {
      border-top: 1px solid rgba(255,255,255,0.1);
      background-color: #0f172a;
      padding: 1.2rem 1.5rem;
    }

    .cart-empty-icon { font-size: 4rem; color: #334155; margin-bottom: 15px; }
    .list-group-item { background-color: transparent; color: #f1f5f9; border-bottom: 1px solid rgba(255,255,255,0.05) !important; padding: 15px 0; }
    .list-group-item:last-child { border-bottom: none !important; }
    .quantity-btn { background: transparent; border: 1px solid #475569; color: #94a3b8; transition: 0.2s; }
    .quantity-btn:hover { background: #475569; color: #fff; }
    .cart-total-price { color: #22d3ee; font-size: 1.4rem; }

    /* Cupom */
    .coupon-section { border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 15px; margin-bottom: 15px; }
    .coupon-section .form-control { background-color: #0f172a; border: 1px solid #475569; color: #fff; }
    .coupon-section .form-control::placeholder { color: #64748b; }
    .coupon-section .btn-outline-info { border-color: #06b6d4; color: #06b6d4; }
    .coupon-section .btn-outline-info:hover { background-color: #06b6d4; color: #fff; }
    .coupon-section .btn-outline-danger { border-color: #ef4444; color: #ef4444; }
    .coupon-section .btn-outline-danger:hover { background-color: #ef4444; color: #fff; }
    .coupon-feedback { margin-top: 5px; font-size: 0.85rem; }
    .cart-offcanvas {
      transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), visibility 0.4s;
    }
    .cart-floating-btn.pulse {
      animation: pulse-cart 0.4s ease-in-out;
    }
    @keyframes pulse-cart {
      0% { transform: scale(1); }
      50% { transform: scale(1.15); box-shadow: 0 0 20px rgba(34,211,238,0.7); }
      100% { transform: scale(1); }
    }
    .list-group-item {
      animation: fadeInItem 0.3s ease;
    }
    @keyframes fadeInItem {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .cart-badge-bounce {
      animation: cartBounce 0.5s ease;
    }
    @keyframes cartBounce {
      0% { transform: scale(1); }
      30% { transform: scale(1.4); }
      50% { transform: scale(0.9); }
      70% { transform: scale(1.1); }
      100% { transform: scale(1); }
    }
        .splash-screen {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: #0b1120;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 99999;
      opacity: 1;
      transition: opacity 0.5s ease;
    }
    .splash-screen.hidden {
      opacity: 0;
      pointer-events: none;
    }
    .splash-content {
      text-align: center;
    }
    .splash-logo {
      max-height: 100px;
      max-width: 100px;
      object-fit: contain;
      margin-bottom: 20px;
      animation: splashLogoPulse 1s infinite ease-in-out;
    }
    .splash-logo-icon {
      font-size: 5rem;
      color: #6366f1;
      margin-bottom: 20px;
      animation: splashLogoPulse 1s infinite ease-in-out;
    }
    .spinner {
      width: 40px;
      height: 40px;
      border: 4px solid rgba(255,255,255,0.2);
      border-top-color: #22d3ee;
      border-radius: 50%;
      margin: 0 auto;
      animation: spin 1s linear infinite;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    @keyframes splashLogoPulse {
      0% { transform: scale(1); opacity: 1; }
      50% { transform: scale(0.95); opacity: 0.8; }
      100% { transform: scale(1); opacity: 1; }
    }
    .splash-screen {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: #0b1120;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 99999;
      opacity: 1;
      transition: opacity 0.5s ease;
    }
    .splash-screen.hidden {
      opacity: 0;
      pointer-events: none;
    }
