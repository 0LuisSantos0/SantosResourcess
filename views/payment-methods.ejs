<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Métodos de Pagamento | Santos Resources</title>
  
  <link rel="icon" href="<%= siteSettings.logo_url ? siteSettings.logo_url : 'data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🛒</text></svg>' %>" />
  
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800;900&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

  <style>
    :root {
      --primary: #6366f1;
      --primary-dark: #4f46e5;
      --dark-bg: #0b1120;
      --card-bg: rgba(255,255,255,0.05);
      --glass-border: rgba(255,255,255,0.1);
    }

    * { box-sizing: border-box; }
    body {
      font-family: 'Inter', sans-serif;
      background-color: #f8fafc;
      color: #1e293b;
      overflow-x: hidden;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .navbar-glass {
      background: rgba(11, 17, 32, 0.8);
      backdrop-filter: blur(16px) saturate(180%);
      border-bottom: 1px solid var(--glass-border);
      transition: all 0.3s ease;
      padding: 0.8rem 0;
    }
    .navbar-glass .nav-link {
      color: rgba(255,255,255,0.7);
      font-weight: 500;
      transition: color 0.2s;
      position: relative;
    }
    .navbar-glass .nav-link:hover,
    .navbar-glass .nav-link.active { color: #fff; }
    .navbar-glass .nav-link::after {
      content: '';
      position: absolute;
      width: 0;
      height: 2px;
      bottom: 0;
      left: 50%;
      background: var(--primary);
      transition: all 0.3s;
      transform: translateX(-50%);
    }
    .navbar-glass .nav-link:hover::after,
    .navbar-glass .nav-link.active::after { width: 80%; }

    .navbar .dropdown-menu {
      background-color: #1e293b;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 12px;
      padding: 0.5rem;
      min-width: 180px;
      margin-top: 0.5rem;
      box-shadow: 0 15px 40px rgba(0,0,0,0.4);
      position: absolute;
      top: 100%;
      right: 0;
      left: auto;
    }
    .navbar .dropdown-item {
      color: #94a3b8;
      border-radius: 8px;
      padding: 10px 15px;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .navbar .dropdown-item:hover, 
    .navbar .dropdown-item:focus {
      background: rgba(255,255,255,0.1);
      color: #ffffff;
      transform: translateX(3px);
    }
    .navbar .dropdown-divider { border-color: rgba(255,255,255,0.06); margin: 4px 0; }
    .dropdown-toggle { cursor: pointer; user-select: none; }
    .dropdown-toggle::after { display: none; }
    .navbar .dropdown:hover .dropdown-menu { display: block; margin-top: 0.25rem; }

    .section-glow { position: relative; box-shadow: 0 10px 30px -10px rgba(34, 211, 238, 0.5); }
    .section-glow::after { content: ''; position: absolute; bottom: -1px; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, transparent, #22d3ee, #6366f1, transparent); box-shadow: 0 0 15px rgba(34, 211, 238, 0.8); z-index: 10; }

    .page-header {
      padding: 140px 0 80px;
      background: radial-gradient(circle at 10% 20%, #1e1b4b 0%, #0f172a 70%, #0b1120 100%);
      color: white;
      text-align: center;
    }
    .page-header h1 { font-weight: 900; font-size: clamp(2.5rem, 5vw, 4rem); }

    footer { background: #0b1120; color: #cbd5e1; padding: 50px 0 20px; margin-top: auto; }
    footer h5, footer h6 { color: #ffffff; font-weight: 600; }
    footer a { color: #a5b4fc; text-decoration: none; transition: 0.2s; }
    footer a:hover { color: var(--primary); }
    .footer-divider { border-color: rgba(255,255,255,0.12); }
    .footer-tagline { color: #e2e8f0; font-size: 0.875rem; line-height: 1.6; }
    .social-icon { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,0.08); color: #fff; transition: all 0.3s; }
    .social-icon:hover { background: var(--primary); transform: translateY(-3px); }

    .cart-floating-btn { position: fixed; bottom: 30px; right: 30px; z-index: 999; background: #0f172a; color: white; border-radius: 50px; padding: 16px 28px; box-shadow: 0 10px 40px rgba(0,0,0,0.3); border: none; transition: all 0.3s ease; }
    .cart-floating-btn:hover { transform: scale(1.05); background: #1e293b; box-shadow: 0 8px 30px rgba(15, 23, 42, 0.6); }
    .cart-badge { position: absolute; top: -6px; right: -6px; background: #ef4444; color: white; border-radius: 50%; width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: bold; }

    /* Cards de método de pagamento */
    .payment-card {
      background: white;
      border-radius: 16px;
      border: 1px solid #e2e8f0;
      box-shadow: 0 4px 10px rgba(0,0,0,0.05);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      height: 100%;
    }
    .payment-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }
    .payment-icon {
      font-size: 3.5rem;
      line-height: 1;
      margin-bottom: 15px;
      display: inline-block;
    }

    .splash-screen {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: radial-gradient(circle at 20% 20%, #1e1b4b, #0b1120 60%, #020617);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 99999;
      opacity: 1;
      transition: opacity 0.5s ease;
      overflow: hidden;
    }
    .splash-screen.hidden {
      opacity: 0;
      pointer-events: none;
    }
    .splash-content { text-align: center; position: relative; z-index: 10; }
    .splash-logo {
      max-height: 100px;
      max-width: 100px;
      object-fit: contain;
      margin-bottom: 20px;
      animation: splashLogoPulse 1.5s infinite ease-in-out;
      filter: drop-shadow(0 0 20px rgba(99,102,241,0.4));
    }
    .splash-logo-icon {
      font-size: 5rem;
      color: #6366f1;
      margin-bottom: 20px;
      animation: splashLogoPulse 1.5s infinite ease-in-out;
    }
    @keyframes splashLogoPulse {
      0% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.08); opacity: 0.85; }
      100% { transform: scale(1); opacity: 1; }
    }
    .splash-title {
      font-family: 'Inter', sans-serif;
      font-weight: 800;
      font-size: 2rem;
      color: #ffffff;
      margin-top: 10px;
      margin-bottom: 20px;
      background: linear-gradient(90deg, #6366f1, #22d3ee, #6366f1);
      background-size: 200% auto;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: splashShimmer 2s linear infinite;
    }
    @keyframes splashShimmer {
      0% { background-position: 0% center; }
      100% { background-position: 200% center; }
    }
    .spinner {
      width: 50px;
      height: 50px;
      border: 4px solid rgba(255,255,255,0.1);
      border-top-color: #22d3ee;
      border-radius: 50%;
      margin: 0 auto;
      animation: spin 0.8s linear infinite;
      box-shadow: 0 0 15px rgba(34,211,238,0.3);
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>
</head>
<body class="d-flex flex-column min-vh-100">

  <!-- Splash Screen -->
  <div id="splashScreen" class="splash-screen">
    <div class="splash-content">
      <% if (siteSettings.logo_url) { %>
        <img src="<%= siteSettings.logo_url %>" alt="Logo" class="splash-logo">
      <% } else { %>
        <i class="fa-solid fa-cube splash-logo-icon"></i>
      <% } %>
      <h1 class="splash-title">Santos Resources</h1>
    </div>
  </div>

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark navbar-glass fixed-top">
    <div class="container">
      <a class="navbar-brand fw-bold d-flex align-items-center" href="/">
        <% if (siteSettings.logo_url) { %>
          <img src="<%= siteSettings.logo_url %>" alt="Logo" class="me-2" style="height: 30px; width: 30px; object-fit: contain;">
        <% } else { %>
          <i class="fa-solid fa-cube me-2 text-primary" style="color: #6366f1;"></i>
        <% } %>
        Santos Resources
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav mx-auto">
          <li class="nav-item"><a class="nav-link" href="/">Início</a></li>
          <li class="nav-item"><a class="nav-link" href="/products">Produtos</a></li>
          <li class="nav-item"><a class="nav-link" href="/about">Sobre Nós</a></li>
          <li class="nav-item"><a class="nav-link active" href="/payment-methods">Pagamentos</a></li>
          <li class="nav-item"><a class="nav-link" href="https://discord.gg/8GyNS5vRgt" target="_blank"><i class="fa-brands fa-discord me-1"></i> Discord</a></li>
        </ul>
        <div class="d-flex align-items-center gap-3">
          <% if (user) { %>
            <div class="dropdown">
              <span class="text-light small dropdown-toggle d-flex align-items-center gap-2" style="cursor: pointer;">
                <% if (user.avatar) { %>
                  <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" width="30" height="30" class="rounded-circle border border-light" alt="Avatar" style="object-fit: cover;">
                <% } else { %>
                  <i class="fa-regular fa-circle-user fa-lg"></i>
                <% } %>
                <strong class="d-none d-md-inline"><%= user.username %></strong>
              </span>
              <ul class="dropdown-menu dropdown-menu-end">
                <% if (isAdmin) { %>
                  <li><a class="dropdown-item" href="/admin/dashboard"><i class="fa-solid fa-screwdriver-wrench text-warning"></i> Painel Admin</a></li>
                  <li><hr class="dropdown-divider"></li>
                <% } %>
                <li><a class="dropdown-item" href="/logout"><i class="fa-solid fa-right-from-bracket text-danger"></i> Sair</a></li>
              </ul>
            </div>
          <% } else { %>
            <a href="/auth/discord" class="btn btn-primary btn-sm px-4 rounded-pill btn-glow"><i class="fa-brands fa-discord me-2"></i>Entrar</a>
          <% } %>
        </div>
      </div>
    </div>
  </nav>

  <!-- Conteúdo principal -->
  <main class="flex-fill">
    <div class="page-header section-glow">
      <div class="container">
        <h1 data-aos="fade-down">Métodos de Pagamento</h1>
        <p class="lead text-light opacity-75" data-aos="fade-down" data-aos-delay="100">Formas simples e seguras de pagar.</p>
      </div>
    </div>

    <div class="container mt-5">
      <div class="row">
        <% if (methods.length === 0) { %>
          <div class="col-12 text-center text-muted py-5" data-aos="fade-up">
            <h4><i class="fa-regular fa-circle-question me-2"></i> Ainda não temos métodos de pagamento disponíveis.</h4>
          </div>
        <% } else { %>
          <% methods.forEach((m, index) => { %>
            <div class="col-md-4 mb-4" data-aos="fade-up" data-aos-delay="<%= index * 100 %>">
              <div class="card payment-card p-4 text-center">
                <i class="fa-solid <%= m.icon || 'fa-credit-card' %> payment-icon"></i>
                <h5 class="card-title fw-bold"><%= m.name %></h5>
                <p class="card-text text-muted"><%= m.description %></p>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer>
    <div class="container">
      <div class="row">
        <div class="col-md-4 mb-4">
          <h5 class="fw-bold d-flex align-items-center">
            <% if (siteSettings.logo_url) { %>
              <img src="<%= siteSettings.logo_url %>" alt="Logo" class="me-2" style="height: 28px; width: 28px; object-fit: contain;">
            <% } else { %>
              <i class="fa-solid fa-cube text-primary me-2"></i>
            <% } %>
            Santos Resources
          </h5>
          <p class="footer-tagline mt-2">Soluções de alta performance para MTA e Discord. Confiança e qualidade.</p>
        </div>
        <div class="col-md-4 mb-4 text-center">
          <h6 class="fw-bold">Links Rápidos</h6>
          <div class="d-flex flex-column">
            <a href="/products" class="small mb-1">Produtos</a>
            <a href="/about" class="small mb-1">Sobre Nós</a>
            <a href="/payment-methods" class="small mb-1">Métodos de Pagamento</a>
            <a href="https://discord.gg/8GyNS5vRgt" target="_blank" class="small">Discord</a>
          </div>
        </div>
        <div class="col-md-4 mb-4 text-end">
          <h6 class="fw-bold">Redes Sociais</h6>
          <div class="d-flex justify-content-end gap-2">
            <a href="https://discord.gg/8GyNS5vRgt" target="_blank" class="social-icon"><i class="fa-brands fa-discord"></i></a>
          </div>
        </div>
      </div>
      <hr class="footer-divider">
      <p class="mb-0 small text-center text-light opacity-75">&copy; 2026 Santos Resources. Todos os direitos reservados.</p>
    </div>
  </footer>

  <!-- Botão Carrinho -->
  <button class="cart-floating-btn" data-bs-toggle="offcanvas" data-bs-target="#cartDrawer"><i class="fa-solid fa-cart-shopping fa-lg"></i><span class="cart-badge" id="cartCount">0</span></button>

  <!-- Drawer Carrinho (simplificado) -->
  <div class="offcanvas offcanvas-end cart-offcanvas" tabindex="-1" id="cartDrawer" aria-labelledby="cartDrawerLabel">
    <div class="offcanvas-header">
      <h5 class="offcanvas-title fw-bold" id="cartDrawerLabel"><i class="fa-solid fa-cart-shopping text-info me-2"></i> Seu Carrinho</h5>
      <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column p-0">
      <div class="cart-items-scroll">
        <div id="cartItemsContainer">
          <div id="emptyCartMsg" class="text-center py-5">
            <i class="fa-solid fa-cart-plus cart-empty-icon"></i>
            <h5 class="text-secondary">Seu carrinho está vazio.</h5>
            <p class="text-muted small">Adicione produtos para continuar.</p>
          </div>
          <ul class="list-group list-group-flush" id="cartItemsList" style="display: none;"></ul>
        </div>
      </div>
      <div class="cart-footer-sticky">
        <div class="d-flex justify-content-between fw-bold text-white mt-2">
          <span>Total:</span>
          <span class="cart-total-price" id="cartTotal">€0.00</span>
        </div>
        <div class="mt-3">
          <a href="https://discord.gg/8GyNS5vRgt" target="_blank" class="btn btn-success w-100 rounded-pill fw-bold btn-glow"><i class="fa-brands fa-discord me-2"></i> Processar Pagamento</a>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  <script>
    AOS.init({ duration: 800, once: true });

    // Lógica do carrinho (básica para não quebrar)
    let cart = [];
    async function loadCart() {
      try {
        const response = await fetch('/api/cart');
        if (response.ok) {
          cart = await response.json();
          updateCartUI();
        }
      } catch (e) {}
    }
    function updateCartUI() {
      const badge = document.getElementById('cartCount');
      const list = document.getElementById('cartItemsList');
      const empty = document.getElementById('emptyCartMsg');
      const totalSpan = document.getElementById('cartTotal');
      const totalItems = cart.reduce((sum, i) => sum + i.quantity, 0);
      badge.textContent = totalItems;
      if (cart.length === 0) {
        list.style.display = 'none';
        empty.style.display = 'block';
        totalSpan.textContent = '€0.00';
        return;
      }
      empty.style.display = 'none';
      list.style.display = 'block';
      let subtotal = 0;
      list.innerHTML = cart.map((item, idx) => {
        const itemTotal = item.price * item.quantity;
        subtotal += itemTotal;
        return `<li class="list-group-item d-flex justify-content-between align-items-center px-0 border-0 border-bottom">
          <div>
            <div><span class="fw-semibold">${item.name}</span></div>
            <div class="d-flex align-items-center mt-1">
              <button class="btn btn-sm btn-outline-secondary rounded-circle px-2 me-1" onclick="changeQuantity(${idx}, -1)">-</button>
              <span class="mx-1 fw-bold">${item.quantity}</span>
              <button class="btn btn-sm btn-outline-secondary rounded-circle px-2 ms-1" onclick="changeQuantity(${idx}, 1)">+</button>
            </div>
          </div>
          <div><span class="fw-bold me-3">€${itemTotal.toFixed(2)}</span>
            <button class="btn btn-sm btn-outline-danger rounded-circle" onclick="removeFromCart(${idx})"><i class="fa-solid fa-xmark"></i></button>
          </div>
        </li>`;
      }).join('');
      totalSpan.textContent = `€${subtotal.toFixed(2)}`;
    }
    async function saveCart() {
      await fetch('/api/cart', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ cart })
      });
    }
    function changeQuantity(index, delta) {
      cart[index].quantity += delta;
      if (cart[index].quantity <= 0) {
        cart.splice(index, 1);
      }
      saveCart();
      updateCartUI();
    }
    function removeFromCart(index) {
      cart.splice(index, 1);
      saveCart();
      updateCartUI();
    }
    document.addEventListener('DOMContentLoaded', loadCart);

    // Splash screen
    window.addEventListener('load', function() {
      setTimeout(() => {
        const splash = document.getElementById('splashScreen');
        if (splash) splash.classList.add('hidden');
      }, 1000);
    });
  </script>
</body>
</html>