<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin | Dashboard</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    body { font-family: 'Inter', sans-serif; background: #f1f5f9; }
    .sidebar { min-height: 100vh; background: linear-gradient(180deg, #0f172a 0%, #1e1b4b 100%); color: white; position: sticky; top: 0; height: 100vh; }
    .sidebar a { color: #94a3b8; text-decoration: none; padding: 12px 20px; display: block; border-radius: 12px; margin: 4px 10px; transition: 0.3s; }
    .sidebar a:hover, .sidebar a.active { background: rgba(255,255,255,0.1); color: white; transform: translateX(5px); }
    
    .stat-card { border: none; border-radius: 20px; background: white; padding: 25px; box-shadow: 0 4px 20px rgba(0,0,0,0.03); transition: 0.3s; }
    .stat-card:hover { transform: translateY(-5px); box-shadow: 0 10px 30px rgba(0,0,0,0.08); }
    .stat-icon { width: 50px; height: 50px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
    
    .welcome-card { background: linear-gradient(135deg, #0f172a, #1e1b4b); color: white; border-radius: 20px; padding: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
    .welcome-card a { color: white; text-decoration: none; }
  </style>
</head>
<body>
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-3 col-lg-2 sidebar p-3 d-flex flex-column">
        <div class="sidebar-header text-center mb-4">
          <h4 class="fw-bold text-warning mt-2"><i class="fa-solid fa-screwdriver-wrench me-2"></i> Admin</h4>
          <hr class="border-secondary">
          <div class="text-start small text-light-emphasis mt-2 px-2"><i class="fa-regular fa-circle-user me-2"></i> <%= user ? user.username : 'Admin' %></div>
        </div>
        <nav class="nav flex-column mb-auto">
          <a href="/admin/dashboard" class="active"><i class="fa-solid fa-chart-simple me-2"></i> Dashboard</a>
          <a href="/admin"><i class="fa-solid fa-box me-2"></i> Produtos</a>
          <a href="/admin/users"><i class="fa-solid fa-users me-2"></i> Utilizadores</a>
          <a href="/admin/discounts"><i class="fa-solid fa-tags me-2"></i> Descontos</a>
          <a href="/admin/logs"><i class="fa-solid fa-clock-rotate-left me-2"></i> Logs</a>
          <a href="/admin/settings"><i class="fa-solid fa-gear me-2"></i> Configurações</a>
        </nav>
        <div class="mt-auto pt-3 border-top border-secondary">
          <a href="/" class="text-light"><i class="fa-solid fa-arrow-left me-2"></i> Voltar ao Site</a>
          <a href="/logout" class="text-danger mt-2"><i class="fa-solid fa-right-from-bracket me-2"></i> Sair</a>
        </div>
      </div>

      <div class="col-md-9 col-lg-10 p-4">
        <h3 class="fw-bold mb-4 text-dark"><i class="fa-solid fa-chart-line text-primary me-2"></i> Painel de Controlo</h3>
        
        <!-- Estatísticas -->
        <div class="row g-4 mb-5">
          <div class="col-md-6 col-lg-3">
            <div class="stat-card">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="text-muted mb-0">Utilizadores</h6>
                <div class="stat-icon bg-info bg-opacity-10 text-info"><i class="fa-solid fa-users"></i></div>
              </div>
              <h3 class="fw-bold mb-0"><%= stats.total_users %></h3>
            </div>
          </div>
          <div class="col-md-6 col-lg-3">
            <div class="stat-card">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="text-muted mb-0">Scripts MTA</h6>
                <div class="stat-icon bg-primary bg-opacity-10 text-primary"><i class="fa-solid fa-gamepad"></i></div>
              </div>
              <h3 class="fw-bold mb-0"><%= stats.mta_scripts %></h3>
            </div>
          </div>
          <div class="col-md-6 col-lg-3">
            <div class="stat-card">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="text-muted mb-0">Bots Discord</h6>
                <div class="stat-icon bg-success bg-opacity-10 text-success"><i class="fa-solid fa-robot"></i></div>
              </div>
              <h3 class="fw-bold mb-0"><%= stats.discord_bots %></h3>
            </div>
          </div>
          <div class="col-md-6 col-lg-3">
            <div class="stat-card">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="text-muted mb-0">Sites</h6>
                <div class="stat-icon bg-orange bg-opacity-10 text-warning"><i class="fa-solid fa-globe"></i></div>
              </div>
              <h3 class="fw-bold mb-0"><%= stats.site_scripts %></h3>
            </div>
          </div>
          <div class="col-md-6 col-lg-3">
            <div class="stat-card">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="text-muted mb-0">Descontos</h6>
                <div class="stat-icon bg-warning bg-opacity-10 text-warning"><i class="fa-solid fa-tags"></i></div>
              </div>
              <h3 class="fw-bold mb-0"><%= stats.total_discounts %></h3>
            </div>
          </div>
        </div>

        <div class="row g-4">
          <!-- Gráfico -->
          <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
              <h5 class="fw-bold mb-4"><i class="fa-solid fa-chart-pie text-primary me-2"></i> Distribuição da Loja</h5>
              <div class="d-flex justify-content-center align-items-center" style="height: 250px;">
                <canvas id="mainChart"></canvas>
              </div>
            </div>
          </div>
          
          <!-- Boas-vindas Premium -->
          <div class="col-lg-6">
            <div class="welcome-card h-100 d-flex flex-column justify-content-center">
              <h4 class="fw-bold mb-2">Olá, <%= user ? user.username : 'Admin' %>! 👋</h4>
              <p class="mb-4 opacity-75">O seu negócio está a crescer. Utilize os links abaixo para gerir rapidamente a sua loja.</p>
              <div class="d-flex flex-wrap gap-2">
                <a href="/admin" class="btn btn-light btn-sm shadow-sm rounded-pill px-4 fw-bold text-dark"><i class="fa-solid fa-box me-2 text-primary"></i> Produtos</a>
                <a href="/admin/discounts" class="btn btn-light btn-sm shadow-sm rounded-pill px-4 fw-bold text-dark"><i class="fa-solid fa-tags me-2 text-warning"></i> Descontos</a>
                <a href="/admin/logs" class="btn btn-light btn-sm shadow-sm rounded-pill px-4 fw-bold text-dark"><i class="fa-solid fa-clock-rotate-left me-2 text-info"></i> Logs</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const ctx = document.getElementById('mainChart').getContext('2d');
    const myChart = new Chart(ctx, {
      type: 'doughnut',
      data: {
        labels: ['Utilizadores', 'Scripts MTA', 'Bots Discord', 'Sites', 'Descontos'],
        datasets: [{
          data: [<%= stats.total_users %>, <%= stats.mta_scripts %>, <%= stats.discord_bots %>, <%= stats.site_scripts %>, <%= stats.total_discounts %>],
          backgroundColor: ['#0ea5e9', '#6366f1', '#10b981', '#f59e0b', '#f97316'],
          borderWidth: 0
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'bottom',
            labels: { usePointStyle: true, font: { family: 'Inter', size: 12 } }
          }
        }
      }
    });
  </script>
</body>
</html>