<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin | Configurações</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body { font-family: 'Inter', sans-serif; background: #f1f5f9; }
    .sidebar { min-height: 100vh; background: linear-gradient(180deg, #0f172a 0%, #1e1b4b 100%); color: white; position: sticky; top: 0; height: 100vh; }
    .sidebar a { color: #94a3b8; text-decoration: none; padding: 12px 20px; display: block; border-radius: 12px; margin: 4px 10px; transition: 0.3s; }
    .sidebar a:hover, .sidebar a.active { background: rgba(255,255,255,0.1); color: white; transform: translateX(5px); }
    .admin-card { border: none; border-radius: 20px; background: white; box-shadow: 0 4px 20px rgba(0,0,0,0.03); }
  </style>
</head>
<body>
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-3 col-lg-2 sidebar p-3 d-flex flex-column">
        <div class="sidebar-header text-center mb-4">
          <h4 class="fw-bold text-warning mt-2"><i class="fa-solid fa-screwdriver-wrench me-2"></i> Admin</h4>
          <hr class="border-secondary">
          <div class="text-start small text-light-emphasis mt-2 px-2"><i class="fa-regular fa-circle-user me-2"></i> <%= user ? user.username : 'Admin' %></div>
        </div>
        <nav class="nav flex-column mb-auto">
          <a href="/admin/dashboard"><i class="fa-solid fa-chart-simple me-2"></i> Dashboard</a>
          <a href="/admin"><i class="fa-solid fa-box me-2"></i> Produtos</a>
          <a href="/admin/users"><i class="fa-solid fa-users me-2"></i> Utilizadores</a>
          <a href="/admin/discounts"><i class="fa-solid fa-tags me-2"></i> Descontos</a>
          <a href="/admin/logs"><i class="fa-solid fa-clock-rotate-left me-2"></i> Logs</a>
          <a href="/admin/settings" class="active"><i class="fa-solid fa-gear me-2"></i> Configurações</a>
        </nav>
        <div class="mt-auto pt-3 border-top border-secondary">
          <a href="/" class="text-light"><i class="fa-solid fa-arrow-left me-2"></i> Voltar ao Site</a>
          <a href="/logout" class="text-danger mt-2"><i class="fa-solid fa-right-from-bracket me-2"></i> Sair</a>
        </div>
      </div>

      <div class="col-md-9 col-lg-10 p-4">
        <div class="card admin-card shadow-sm p-4">
          <h5 class="fw-bold mb-4"><i class="fa-solid fa-gear text-primary me-2"></i> Configurações do Site</h5>
          <form action="/admin/settings/update" method="POST">
            <div class="mb-3">
              <label class="form-label fw-bold">Nome do Site</label>
              <input type="text" name="site_name" class="form-control" value="<%= settings.site_name %>" required>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold">Link do Discord (Convite)</label>
              <input type="url" name="discord_link" class="form-control" value="<%= settings.discord_link %>" required>
            </div>
            <button type="submit" class="btn btn-primary fw-bold px-5 rounded-pill">Guardar Alterações</button>
          </form>
        </div>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>