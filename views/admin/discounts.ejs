<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin | Descontos</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body { font-family: 'Inter', sans-serif; background: #f1f5f9; }
    .sidebar { min-height: 100vh; background: linear-gradient(180deg, #0f172a 0%, #1e1b4b 100%); color: white; position: sticky; top: 0; height: 100vh; }
    .sidebar a { color: #94a3b8; text-decoration: none; padding: 12px 20px; display: block; border-radius: 12px; margin: 4px 10px; transition: 0.3s; }
    .sidebar a:hover, .sidebar a.active { background: rgba(255,255,255,0.15); color: white; transform: translateX(5px); border-left: 4px solid #22d3ee; }
    .admin-card { border: none; border-radius: 20px; background: white; box-shadow: 0 8px 24px rgba(0,0,0,0.04); }
    .action-btn { width: 35px; height: 35px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; transition: 0.2s; }
    .action-btn:hover { transform: scale(1.1); }
    .modal-content { border-radius: 20px; }
  </style>
</head>
<body>
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-3 col-lg-2 sidebar p-3 d-flex flex-column">
        <div class="sidebar-header text-center mb-4">
          <h4 class="fw-bold text-warning mt-2"><i class="fa-solid fa-screwdriver-wrench me-2"></i> Admin</h4>
          <hr class="border-secondary">
          <div class="text-start small text-light-emphasis mt-2 px-2"><i class="fa-regular fa-circle-user me-2"></i> <%= user ? user.username : 'Admin' %></div>
        </div>
        <nav class="nav flex-column mb-auto">
          <a href="/admin/dashboard"><i class="fa-solid fa-chart-simple me-2"></i> Dashboard</a>
          <a href="/admin"><i class="fa-solid fa-box me-2"></i> Produtos</a>
          <a href="/admin/users"><i class="fa-solid fa-users me-2"></i> Utilizadores</a>
          <a href="/admin/discounts" class="active"><i class="fa-solid fa-tags me-2"></i> Descontos</a>
          <a href="/admin/payment-methods"><i class="fa-solid fa-money-bill-transfer me-2"></i> Pagamentos</a>
          <a href="/admin/logs"><i class="fa-solid fa-clock-rotate-left me-2"></i> Logs</a>
          <a href="/admin/settings"><i class="fa-solid fa-gear me-2"></i> Configurações</a>
        </nav>
        <div class="mt-auto pt-3 border-top border-secondary">
          <a href="/" class="text-light"><i class="fa-solid fa-arrow-left me-2"></i> Voltar ao Site</a>
          <a href="/logout" class="text-danger mt-2"><i class="fa-solid fa-right-from-bracket me-2"></i> Sair</a>
        </div>
      </div>

      <div class="col-md-9 col-lg-10 p-4">
        <div class="admin-card shadow-sm mb-4 p-4">
          <h5 class="fw-bold mb-4"><i class="fa-solid fa-plus-circle text-success me-2"></i> Adicionar Novo Desconto</h5>
          <form action="/admin/discounts/add" method="POST" class="row g-3">
            <div class="col-md-4">
              <label class="form-label small fw-bold text-muted">Código</label>
              <input type="text" name="code" class="form-control bg-light border-0" placeholder="ex: PROMO10" required>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-bold text-muted">Descrição</label>
              <input type="text" name="description" class="form-control bg-light border-0" placeholder="ex: Desconto de verão">
            </div>
            <div class="col-md-2">
              <label class="form-label small fw-bold text-muted">%</label>
              <input type="number" name="percentage" class="form-control bg-light border-0" placeholder="10" required>
            </div>
            <div class="col-md-2 d-flex align-items-end">
              <button type="submit" class="btn btn-primary w-100 fw-bold shadow-sm"><i class="fa-solid fa-check"></i></button>
            </div>
          </form>
        </div>

        <div class="admin-card shadow-sm">
          <div class="p-4 border-bottom">
            <h5 class="fw-bold mb-0"><i class="fa-solid fa-tags text-primary me-2"></i> Descontos Ativos</h5>
          </div>
          <div class="p-0">
            <% if (error) { %><div class="alert alert-danger m-4"><%= error %></div><% } %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                  <tr><th class="ps-4">ID</th><th>Código</th><th>Descrição</th><th class="text-center">%</th><th class="text-center">Status</th><th class="text-end pe-4">Ações</th></tr>
                </thead>
                <tbody>
                  <% discounts.forEach(d => { %>
                    <tr>
                      <td class="ps-4 fw-bold text-secondary">#<%= d.id %></td>
                      <td class="fw-bold text-uppercase"><%= d.code %></td>
                      <td class="small text-muted"><%= d.description %></td>
                      <td class="text-center fw-bold"><%= d.percentage %>%</td>
                      <td class="text-center">
                        <% if (d.is_active === 1) { %><span class="badge bg-success rounded-pill px-3">Ativo</span><% } else { %><span class="badge bg-danger rounded-pill px-3">Inativo</span><% } %>
                      </td>
                      <td class="text-end pe-4">
                        <div class="d-flex justify-content-end gap-2">
                          <button type="button" class="action-btn <%= d.is_active === 1 ? 'btn btn-outline-danger' : 'btn btn-success' %>" title="<%= d.is_active === 1 ? 'Desativar' : 'Ativar' %>" onclick="openToggleModal('/admin/discounts/toggle/<%= d.id %>', '<%= d.is_active === 1 ? 'Desativar' : 'Ativar' %>', '<%= d.code.replace(/'/g, "\\'") %>')">
                            <% if (d.is_active === 1) { %><i class="fa-solid fa-eye-slash"></i><% } else { %><i class="fa-solid fa-eye"></i><% } %>
                          </button>
                          <button type="button" class="action-btn btn btn-warning" title="Editar" data-bs-toggle="modal" data-bs-target="#editDiscountModal<%= d.id %>"><i class="fa-solid fa-pen-to-square"></i></button>
                          <button type="button" class="action-btn btn btn-danger" title="Apagar" onclick="openDeleteModal('/admin/discounts/delete/<%= d.id %>', '<%= d.code.replace(/'/g, "\\'") %>')">
                            <i class="fa-solid fa-trash-can"></i>
                          </button>
                        </div>
                      </td>
                    </tr>
                    
                    <!-- Modal de Edição de Desconto -->
                    <div class="modal fade" id="editDiscountModal<%= d.id %>" tabindex="-1">
                      <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content p-2">
                          <div class="modal-header border-0">
                            <h5 class="modal-title fw-bold">Editar: <%= d.code %></h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                          </div>
                          <form id="editForm_<%= d.id %>" action="/admin/discounts/edit/<%= d.id %>" method="POST">
                            <div class="modal-body">
                              <div class="mb-3"><label class="form-label small">Código</label><input type="text" name="code" class="form-control" value="<%= d.code %>" required></div>
                              <div class="mb-3"><label class="form-label small">Descrição</label><input type="text" name="description" class="form-control" value="<%= d.description %>"></div>
                              <div class="mb-3"><label class="form-label small">%</label><input type="number" name="percentage" class="form-control" value="<%= d.percentage %>" required></div>
                            </div>
                            <div class="modal-footer border-0">
                              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                              <button type="button" class="btn btn-primary fw-bold" onclick="openEditConfirmModal(document.getElementById('editForm_<%= d.id %>'))">Salvar</button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modais de confirmação gerais -->
  <div class="modal fade" id="editConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content p-3">
        <div class="modal-header border-0">
          <h5 class="modal-title fw-bold text-primary"><i class="fa-solid fa-pen-to-square me-2"></i> Confirmar Edição</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" id="editConfirmModalMessage">Tem certeza que deseja salvar as alterações?</div>
        <div class="modal-footer border-0">
          <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold" id="confirmEditBtn">Sim, Salvar</button>
        </div>
      </div>
    </div>
  </div>
  <div class="modal fade" id="toggleConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content p-3">
        <div class="modal-header border-0">
          <h5 class="modal-title fw-bold text-warning"><i class="fa-solid fa-toggle-on me-2"></i> Confirmar Alteração de Status</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" id="toggleModalMessage">Tem certeza que deseja alterar o status deste desconto?</div>
        <div class="modal-footer border-0">
          <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-warning rounded-pill px-4 fw-bold" id="confirmToggleBtn">Sim, Alterar</button>
        </div>
      </div>
    </div>
  </div>
  <div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content p-3">
        <div class="modal-header border-0">
          <h5 class="modal-title fw-bold text-danger"><i class="fa-solid fa-triangle-exclamation me-2"></i> Confirmar Exclusão</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" id="deleteModalMessage">Tem certeza que deseja apagar este item? <br><span class="text-danger fw-bold">Esta ação é irreversível!</span></div>
        <div class="modal-footer border-0">
          <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-danger rounded-pill px-4 fw-bold" id="confirmDeleteBtn">Sim, Apagar</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    let currentEditForm = null;
    function openEditConfirmModal(form) {
        currentEditForm = form;
        const codeInput = form.querySelector('input[name="code"]');
        document.getElementById('editConfirmModalMessage').innerHTML = `Tem certeza que deseja salvar as alterações em <strong>${codeInput ? codeInput.value : 'este desconto'}</strong>?`;
        const myModal = new bootstrap.Modal(document.getElementById('editConfirmModal'));
        myModal.show();
    }
    document.getElementById('confirmEditBtn').addEventListener('click', function() {
        if(currentEditForm) currentEditForm.submit();
    });

    let currentToggleForm = document.getElementById('toggleForm');
    if(!currentToggleForm) {
        currentToggleForm = document.createElement('form');
        currentToggleForm.id = 'toggleForm';
        currentToggleForm.method = 'POST';
        document.body.appendChild(currentToggleForm);
    }
    function openToggleModal(action, statusAction, itemCode) {
        document.getElementById('toggleModalMessage').innerHTML = `Tem certeza que deseja <strong>${statusAction}</strong> o desconto <strong>${itemCode}</strong>?`;
        currentToggleForm.action = action;
        const myModal = new bootstrap.Modal(document.getElementById('toggleConfirmModal'));
        myModal.show();
    }
    document.getElementById('confirmToggleBtn').addEventListener('click', function() {
        currentToggleForm.submit();
    });

    let currentDeleteForm = document.getElementById('deleteForm');
    if(!currentDeleteForm) {
        currentDeleteForm = document.createElement('form');
        currentDeleteForm.id = 'deleteForm';
        currentDeleteForm.method = 'POST';
        document.body.appendChild(currentDeleteForm);
    }
    function openDeleteModal(action, itemCode) {
        document.getElementById('deleteModalMessage').innerHTML = `Tem certeza que deseja apagar o desconto <strong>${itemCode}</strong>? <br><span class="text-danger fw-bold">Esta ação é irreversível!</span>`;
        currentDeleteForm.action = action;
        const myModal = new bootstrap.Modal(document.getElementById('confirmDeleteModal'));
        myModal.show();
    }
    document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
        currentDeleteForm.submit();
    });
  </script>
</body>
</html>