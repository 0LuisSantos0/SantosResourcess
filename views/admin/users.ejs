<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin | Utilizadores</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body { font-family: 'Inter', sans-serif; background: #f1f5f9; }
    .sidebar { min-height: 100vh; background: linear-gradient(180deg, #0f172a 0%, #1e1b4b 100%); color: white; position: sticky; top: 0; height: 100vh; }
    .sidebar a { color: #94a3b8; text-decoration: none; padding: 12px 20px; display: block; border-radius: 12px; margin: 4px 10px; transition: 0.3s; }
    .sidebar a:hover, .sidebar a.active { background: rgba(255,255,255,0.1); color: white; transform: translateX(5px); }
    .admin-card { border: none; border-radius: 20px; background: white; box-shadow: 0 4px 20px rgba(0,0,0,0.03); }
    .action-btn { width: 35px; height: 35px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; transition: 0.2s; }
    .action-btn:hover { transform: scale(1.1); }
  </style>
</head>
<body>
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-3 col-lg-2 sidebar p-3 d-flex flex-column">
        <div class="sidebar-header text-center mb-4">
          <h4 class="fw-bold text-warning mt-2"><i class="fa-solid fa-screwdriver-wrench me-2"></i> Admin</h4>
          <hr class="border-secondary">
          <div class="text-start small text-light-emphasis mt-2 px-2">
            <i class="fa-regular fa-circle-user me-2"></i> <%= user ? user.username : 'Admin' %>
          </div>
        </div>
        <nav class="nav flex-column mb-auto">
          <a href="/admin/dashboard"><i class="fa-solid fa-chart-simple me-2"></i> Dashboard</a>
          <a href="/admin"><i class="fa-solid fa-box me-2"></i> Produtos</a>
          <a href="/admin/users" class="active"><i class="fa-solid fa-users me-2"></i> Utilizadores</a>
          <a href="/admin/discounts"><i class="fa-solid fa-tags me-2"></i> Descontos</a>
          <a href="/admin/logs"><i class="fa-solid fa-clock-rotate-left me-2"></i> Logs</a>
          <a href="/admin/settings"><i class="fa-solid fa-gear me-2"></i> Configurações</a>
        </nav>
        <div class="mt-auto pt-3 border-top border-secondary">
          <a href="/" class="text-light"><i class="fa-solid fa-arrow-left me-2"></i> Voltar ao Site</a>
          <a href="/logout" class="text-danger mt-2"><i class="fa-solid fa-right-from-bracket me-2"></i> Sair</a>
        </div>
      </div>

      <div class="col-md-9 col-lg-10 p-4">
        <div class="admin-card shadow-sm">
          <div class="p-4 border-bottom">
            <h5 class="fw-bold mb-0"><i class="fa-solid fa-users-gear text-primary me-2"></i> Utilizadores Logados</h5>
          </div>
          <div class="p-0">
            <% if (error) { %><div class="alert alert-danger m-4"><%= error %></div><% } %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                  <tr><th class="ps-4">ID</th><th>Avatar</th><th>Nome Discord</th><th class="text-center">Admin</th><th class="text-center">Último Login</th><th class="text-end pe-4">Ação</th></tr>
                </thead>
                <tbody>
                  <% users.forEach(u => { %>
                    <tr>
                      <td class="ps-4 fw-bold text-secondary">#<%= u.id %></td>
                      <td><img src="https://cdn.discordapp.com/avatars/<%= u.discord_id %>/<%= u.avatar %>.png" width="32" class="rounded-circle border"></td>
                      <td class="fw-semibold"><%= u.username %></td>
                      <td class="text-center">
                        <% if (u.is_admin === 1) { %>
                          <span class="badge bg-warning text-dark rounded-pill px-3">Admin</span>
                        <% } else { %>
                          <span class="badge bg-secondary rounded-pill px-3">Utilizador</span>
                        <% } %>
                      </td>
                      <td class="text-center small text-muted"><%= new Date(u.last_login).toLocaleDateString() %></td>
                      <td class="text-end pe-4">
                        <!-- 🔥 FORMULÁRIO CORRIGIDO: Action exata e método POST -->
                        <form action="/admin/users/toggle/<%= u.id %>" method="POST">
                          <% if (u.is_admin === 1) { %>
                            <button type="submit" class="action-btn btn btn-outline-danger" title="Remover Admin">
                              <i class="fa-solid fa-user-minus"></i>
                            </button>
                          <% } else { %>
                            <button type="submit" class="action-btn btn btn-outline-primary" title="Tornar Admin">
                              <i class="fa-solid fa-user-plus"></i>
                            </button>
                          <% } %>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
